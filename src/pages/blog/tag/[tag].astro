---
// Posts with a given tag.
import Base from '../../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { fmtDate, readingTime } from '../../../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) },
  }));
}
const { tag, posts } = Astro.props;
---
<Base title={`Posts tagged ${tag}`}>
  <h1 class="page-title">Posts tagged &ldquo;{tag}&rdquo;</h1>
  <p class="page-intro"><a href="/blog/">&larr; All posts</a></p>
  <ul class="dated">
    {posts.map((p: any) => (
      <li>
        <span class="when">{fmtDate(p.data.date)}</span>
        <div>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          {p.data.description && <p>{p.data.description}</p>}
          <p class="meta">{readingTime(p.body)}</p>
        </div>
      </li>
    ))}
  </ul>
</Base>
