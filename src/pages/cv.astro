---
// CV: embedded PDF viewer plus download button. Replace the PDF in Admin > Settings > CV.
import Base from '../layouts/Base.astro';
import { CV, SITE, fmtDate } from '../lib/site';
const updated = CV.updated ? fmtDate(new Date(CV.updated)) : null;
---
<Base title="CV" description={`Curriculum vitae of ${SITE.full_name}.`}>
  <h1 class="page-title">Curriculum vitae</h1>
  {CV.intro && <p class="page-intro" style="margin-bottom:0">{CV.intro}{updated && ` Last updated ${updated}.`}</p>}
  <p class="cv-actions">
    <a class="btn" href={CV.pdf} download>Download PDF</a>
    <a class="btn-plain" href={CV.pdf} target="_blank" rel="noopener">Open in a new tab</a>
  </p>
  <object class="cv-frame" data={`${CV.pdf}#view=FitH`} type="application/pdf" aria-label="CV preview">
    <p>Your browser cannot show the PDF here. <a href={CV.pdf}>Download the CV</a> instead.</p>
  </object>
</Base>
