---
// Skills: what tools and methods you use. One row per skill with a figure, a short description,
// the tools involved and optional links (for example to related publications or projects).
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byOrder, pageText } from '../lib/site';

const skills = (await getCollection('skills', (s) => !s.data.hidden)).sort((a, b) => byOrder(a, b) || a.data.title.localeCompare(b.data.title));
const text = pageText('skills', 'Skills', { count: skills.length }, 'The methods and tools I use in clinical research, evidence synthesis and medical AI.');
---
<Base title={text.title} description="Research methods, statistics, evidence synthesis and machine learning skills.">
  <h1 class="page-title">{text.title}</h1>
  {text.intro && <p class="page-intro" set:html={text.intro} />}
  <ul class="project-list skill-list">
    {skills.map((s) => (
      <li class:list={['project', 'skill', { 'no-thumb': !s.data.figure }]} id={s.id}>
        {s.data.figure && <img class="thumb skill-fig" src={s.data.figure} alt={s.data.figure_alt ?? ''} loading="lazy" width="320" height="320" />}
        <div>
          <h2>{s.data.title}</h2>
          <p>{s.data.summary}</p>
          {s.data.tools.length > 0 && <ul class="tool-list">{s.data.tools.map((t) => <li>{t}</li>)}</ul>}
          {s.data.links.length > 0 && (
            <p class="skill-links">{s.data.links.map((l, i) => <>{i > 0 && ' · '}<a href={l.url}>{l.label}</a></>)}</p>
          )}
        </div>
      </li>
    ))}
  </ul>
</Base>
