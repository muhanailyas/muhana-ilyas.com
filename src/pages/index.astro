---
// About (home) page: name, affiliation, photo, bio, interests, news, selected publications.
import Base from '../layouts/Base.astro';
import PubEntry from '../components/PubEntry.astro';
import PubScripts from '../components/PubScripts.astro';
import { getCollection } from 'astro:content';
import { SITE, md, mdInline, fmtMonth } from '../lib/site';
import { getSelected } from '../lib/publications';

const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const shown = news.slice(0, SITE.news_count ?? 6);
const older = news.slice(SITE.news_count ?? 6);
const selected = await getSelected();

// schema.org Person data for search engines
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.full_name,
  honorificPrefix: SITE.honorific,
  jobTitle: SITE.job_title,
  url: Astro.site?.toString(),
  image: new URL(SITE.avatar, Astro.site).toString(),
  alumniOf: SITE.alumni_of.map((n) => ({ '@type': 'CollegeOrUniversity', name: n })),
  worksFor: { '@type': 'Organization', name: SITE.works_for },
  knowsAbout: SITE.interests,
  sameAs: SITE.socials.map((s) => s.url),
};
---
<Base type="profile">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />

  <h1 class="hero-name"><span class="first">{SITE.first_names}</span> <strong>{SITE.last_name}</strong></h1>
  <p class="affil"><strong>{SITE.affiliation_label}:</strong> <Fragment set:html={mdInline(SITE.affiliation)} /></p>

  <figure class="profile">
    <img src={SITE.avatar} alt={SITE.avatar_alt} width="416" height="416" loading="eager" />
    {SITE.location && <figcaption class="meta">{SITE.location}</figcaption>}
  </figure>

  <Fragment set:html={md(SITE.bio)} />

  {SITE.interests?.length > 0 && (
    <>
      <p>My research interests include:</p>
      <ul class="interests">{SITE.interests.map((i) => <li>{i}</li>)}</ul>
    </>
  )}
  {SITE.personal && <p class="personal">{SITE.personal}</p>}
  <div class="clear"></div>

  {shown.length > 0 && (
    <section class="section" aria-labelledby="news-h">
      <h2 id="news-h">News</h2>
      <table class="news">
        <tbody>
          {shown.map((n) => (
            <tr><td class="date">{fmtMonth(n.data.date)}</td><td set:html={mdInline(n.data.text)} /></tr>
          ))}
        </tbody>
      </table>
      {older.length > 0 && (
        <details class="more">
          <summary>Older news</summary>
          <table class="news"><tbody>
            {older.map((n) => (<tr><td class="date">{fmtMonth(n.data.date)}</td><td set:html={mdInline(n.data.text)} /></tr>))}
          </tbody></table>
        </details>
      )}
    </section>
  )}

  {selected.length > 0 && (
    <section class="section" aria-labelledby="sel-h">
      <h2 id="sel-h">Selected publications</h2>
      <ol class="selected-list">
        {selected.map((p) => <li><PubEntry pub={p} /></li>)}
      </ol>
      <p class="more"><a href="/publications/">All publications</a></p>
    </section>
  )}
  <PubScripts />
</Base>
