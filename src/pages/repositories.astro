---
// Repositories: entered by hand in the admin panel (no GitHub API needed).
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { byOrder, pageText } from '../lib/site';

const repos = (await getCollection('repositories', (r) => !r.data.hidden)).sort((a, b) => byOrder(a, b) || a.data.name.localeCompare(b.data.name));
const text = pageText('repositories', 'Repositories', { count: repos.length }, 'Code for my research and coursework, all on [GitHub]({github}).');
---
<Base title={text.title} description="Open-source code and research software.">
  <h1 class="page-title">{text.title}</h1>
  {text.intro && <p class="page-intro" set:html={text.intro} />}
  <ul class="repo-grid">
    {repos.map((r) => (
      <li class="repo">
        <h2><a href={r.data.url} target="_blank" rel="noopener">{r.data.name}</a></h2>
        <p>{r.data.description}</p>
        <p class="meta">
          {[r.data.language, typeof r.data.stars === 'number' && r.data.stars > 0 ? `${r.data.stars} star${r.data.stars === 1 ? '' : 's'}` : null].filter(Boolean).join(' · ')}
          {r.data.demo && <> &middot; <a href={r.data.demo} target="_blank" rel="noopener">Live demo</a></>}
        </p>
      </li>
    ))}
  </ul>
</Base>
