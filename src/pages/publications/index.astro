---
// Publications grouped by year, with a filter by publication type.
import Base from '../../layouts/Base.astro';
import PubEntry from '../../components/PubEntry.astro';
import PubScripts from '../../components/PubScripts.astro';
import { getPublications, TYPE_LABELS } from '../../lib/publications';
import { SITE, pageText } from '../../lib/site';

const pubs = await getPublications();
const years = [...new Set(pubs.map((p) => p.year ?? 0))].sort((a, b) => b - a);
const types = Object.keys(TYPE_LABELS).filter((t) => pubs.some((p) => p.type === t));
const PLURAL: Record<string, string> = { journal: 'Journal articles', conference: 'Conference papers', book: 'Books', 'book-chapter': 'Book chapters', preprint: 'Preprints', thesis: 'Theses', other: 'Other' };
const text = pageText('publications', 'Publications', { count: pubs.length }, '{count} publications, newest first. My name is in bold. An up-to-date list with citation counts is on [Google Scholar]({scholar}).');
---
<Base title={text.title} description={`Publications by ${SITE.full_name}.`}>
  <h1 class="page-title">{text.title}</h1>
  {text.intro && <p class="page-intro" set:html={text.intro} />}

  {types.length > 1 && (
    <div class="filters" role="group" aria-label="Filter by type">
      <button type="button" data-filter="all" aria-pressed="true">All</button>
      {types.map((t) => <button type="button" data-filter={t} aria-pressed="false">{PLURAL[t]}</button>)}
    </div>
  )}

  {years.map((y) => (
    <section class="year-group" data-year={y}>
      <h2>{y || 'Undated'}</h2>
      <ol class="pub-list" reversed>
        {pubs.filter((p) => (p.year ?? 0) === y).map((p) => <li><PubEntry pub={p} showYear={false} /></li>)}
      </ol>
    </section>
  ))}

  <PubScripts />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const f = b.dataset.filter;
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        document.querySelectorAll<HTMLElement>('.pub-list > li').forEach((li) => {
          const type = li.querySelector<HTMLElement>('.pub')?.dataset.type;
          li.hidden = !(f === 'all' || type === f);
        });
        document.querySelectorAll<HTMLElement>('.year-group').forEach((g) => {
          g.hidden = !g.querySelector('.pub-list > li:not([hidden])');
        });
      })
    );
  </script>
</Base>
