---
// Site header: name on the left, navigation on the right, theme toggle and mobile menu button.
import { SITE } from '../lib/site';
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{SITE.first_names} <strong>{SITE.last_name}</strong></a>
    <div class="header-tools">
      <button class="icon-btn theme-toggle" type="button" aria-label="Switch between light and dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    </div>
    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {SITE.menu.map((m) => (
          <li><a href={m.href} aria-current={isActive(m.href) ? 'page' : undefined}>{m.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
<script>
  const root = document.documentElement;
  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
