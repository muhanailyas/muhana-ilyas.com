---
// Footer: a slim dark bar, as on the reference site. Copyright left, email and profile links right.
import { SITE } from '../lib/site';
import Email from './Email.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <p>&copy; Copyright {year} {SITE.full_name}.</p>
    <ul class="links">
      <li><Email address={SITE.email} label="Email" /></li>
      {SITE.socials.map((s) => <li><a href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
</footer>
