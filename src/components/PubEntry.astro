---
// One publication, laid out like al-folio: a journal badge on the left; title, authors
// (your name in bold), venue and small outlined buttons on the right.
import { authorParts, venueLine, pubUrl, type Pub } from '../lib/publications';
interface Props { pub: Pub; showYear?: boolean; linkTitle?: boolean }
const { pub: p, showYear = true, linkTitle = true } = Astro.props;
const uid = `p-${p.id.replace(/[^a-z0-9]/gi, '')}`;
const parts = authorParts(p.authors);
const venue = venueLine(p);
---
<article class="pub" data-type={p.type}>
  <div class="pub-badge">{p.abbr && <span class="abbr">{p.abbr}</span>}</div>
  <div>
    {linkTitle ? <a class="pub-title" href={pubUrl(p)}>{p.title}</a> : <span class="pub-title">{p.title}</span>}
    {parts.length > 0 && (
      <p class="pub-authors">
        {parts.map((a, i) => (
          <>{a.me ? <strong>{a.name}</strong> : <span>{a.name}</span>}{i < parts.length - 1 ? ', ' : ''}</>
        ))}
      </p>
    )}
    <p class="pub-venue">
      {venue && <em>{venue}</em>}{venue && showYear && p.year ? ', ' : ''}{showYear && p.year}{p.note && <span> &middot; {p.note}</span>}
    </p>
    <div class="pub-actions">
      {p.abstract && <button type="button" aria-expanded="false" aria-controls={`${uid}-abs`} data-toggle>Abs</button>}
      <button type="button" aria-expanded="false" aria-controls={`${uid}-bib`} data-toggle>Bib</button>
      {p.doi && <a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">DOI</a>}
      {!p.doi && p.url && <a href={p.url} target="_blank" rel="noopener">HTML</a>}
      {p.pdf && <a href={p.pdf} target="_blank" rel="noopener">PDF</a>}
      {p.code && <a href={p.code} target="_blank" rel="noopener">Code</a>}
      {p.slides && <a href={p.slides} target="_blank" rel="noopener">Slides</a>}
      {p.doi && (p.showAltmetric || p.showDimensions) && (
        <span class="badges">
          {p.showAltmetric && <span class="altmetric-embed" data-badge-type="2" data-doi={p.doi} data-hide-no-mentions="true"></span>}
          {p.showDimensions && <span class="__dimensions_badge_embed__" data-doi={p.doi} data-style="small_rectangle" data-hide-zero-citations="true" data-legend="hover-right"></span>}
        </span>
      )}
    </div>
    {p.abstract && <div class="pub-panel" id={`${uid}-abs`} hidden><p>{p.abstract}</p></div>}
    <div class="pub-panel bib" id={`${uid}-bib`} hidden>
      <button class="textbtn copy" type="button" data-copy={`${uid}-bibtext`}>Copy</button>
      <pre id={`${uid}-bibtext`}>{p.bibtex}</pre>
    </div>
  </div>
</article>
