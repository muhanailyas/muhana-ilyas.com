---
// <head> metadata: title, description, Open Graph, Twitter card, canonical URL, RSS link,
// and optional extra tags (Google Scholar citation tags, JSON-LD) passed in via the slot.
import { SITE } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
}
const { title, description = SITE.description, image = SITE.social_image, type = 'website', noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.full_name}` : `${SITE.full_name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image || '/og-default.png', Astro.site);
---
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={SITE.full_name} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE.full_name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<link rel="alternate" type="application/rss+xml" title={`${SITE.full_name}: Blog`} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<slot />
