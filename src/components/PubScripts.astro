---
// Behaviour shared by every page that lists publications:
// open/close Abstract and Cite panels, copy BibTeX, and load the citation badges
// only when at least one badge is on the page.
---
<script>
  document.addEventListener('click', (ev) => {
    const t = ev.target as HTMLElement;
    const toggle = t.closest<HTMLButtonElement>('button[data-toggle]');
    if (toggle) {
      const panel = document.getElementById(toggle.getAttribute('aria-controls') ?? '');
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      // Close the sibling panel so only one is open per publication.
      toggle.parentElement?.querySelectorAll<HTMLButtonElement>('button[data-toggle]').forEach((b) => {
        if (b !== toggle && b.getAttribute('aria-expanded') === 'true') {
          b.setAttribute('aria-expanded', 'false');
          document.getElementById(b.getAttribute('aria-controls') ?? '')?.setAttribute('hidden', '');
        }
      });
      toggle.setAttribute('aria-expanded', String(open));
      if (panel) open ? panel.removeAttribute('hidden') : panel.setAttribute('hidden', '');
      return;
    }
    const copy = t.closest<HTMLButtonElement>('button[data-copy]');
    if (copy) {
      const text = document.getElementById(copy.dataset.copy ?? '')?.textContent ?? '';
      navigator.clipboard?.writeText(text).then(() => {
        copy.textContent = 'Copied';
        setTimeout(() => (copy.textContent = 'Copy'), 1500);
      });
    }
  });

  function load(src: string) {
    const s = document.createElement('script');
    s.src = src;
    s.async = true;
    document.body.appendChild(s);
  }
  if (document.querySelector('.altmetric-embed')) load('https://d1bxh8uas1mnw7.cloudfront.net/assets/embed.js');
  if (document.querySelector('.__dimensions_badge_embed__')) load('https://badge.dimensions.ai/badge.js');
</script>
