---
// Grid of institution logos. Without an uploaded logo, a neat text box with the short name is shown,
// so every slot looks finished. Logos are shown in greyscale and turn to colour on hover.
import { initials, type Collaborator } from '../lib/collaborators';
interface Props { items: Collaborator[]; projectNames?: Record<string, string>; showProjects?: boolean }
const { items, projectNames = {}, showProjects = false } = Astro.props;
---
<ul class="logo-grid">
  {items.map((c) => {
    const Tag = c.data.url ? 'a' : 'div';
    return (
      <li>
        <Tag class="logo-card" href={c.data.url} target={c.data.url ? '_blank' : undefined} rel={c.data.url ? 'noopener' : undefined}>
          <span class="logo-box">
            {c.data.logo ? <img src={c.data.logo} alt={`${c.data.name} logo`} loading="lazy" /> : <span class="logo-text" aria-hidden="true">{initials(c)}</span>}
          </span>
          <span class="logo-name">{c.data.name}</span>
          {(c.data.country || c.data.year) && <span class="logo-meta">{[c.data.country, c.data.year].filter(Boolean).join(' \u00b7 ')}</span>}
        </Tag>
        {c.data.description && <p class="logo-desc">{c.data.description}</p>}
        {showProjects && c.data.projects.length > 0 && (
          <p class="logo-projects">
            {c.data.projects.filter((id) => projectNames[id]).map((id, i) => (
              <>{i > 0 && ' · '}<a href={`/projects/${id}/`}>{projectNames[id]}</a></>
            ))}
          </p>
        )}
      </li>
    );
  })}
</ul>
