---
// Spam-resistant email link. The address is stored reversed in the HTML and only
// assembled in the visitor's browser, so simple address harvesters cannot read it.
interface Props { address: string; label?: string; subject?: string }
const { address, label, subject } = Astro.props;
const reversed = address.split('').reverse().join('');
const human = address.replace('@', ' [at] ').replace(/\./g, ' [dot] ');
---
<a class="js-email" data-r={reversed} data-label={label ?? ''} data-subject={subject ?? ''} href="#" rel="nofollow">{label ?? human}</a>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
    const addr = (a.dataset.r ?? '').split('').reverse().join('');
    a.href = 'mailto:' + addr + (a.dataset.subject ? '?subject=' + encodeURIComponent(a.dataset.subject) : '');
    if (!a.dataset.label) a.textContent = addr;
  });
</script>
